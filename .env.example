# Database and session security
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_SSL=true
SESSION_DAYS=14

# Object storage (S3-compatible). Required before production file uploads.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_SECONDS=600

# Local AI services. Keep these private; do not expose them through NEXT_PUBLIC_.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
COMFYUI_URL=http://127.0.0.1:8188
# Optional hosted-site bridge. The local bridge listens only on 127.0.0.1;
# expose it through a Cloudflare Tunnel and keep this random value server-side.
OFFICE_AI_BRIDGE_URL=
OFFICE_AI_BRIDGE_TOKEN=

# Sentry error monitoring. This DSN is safe to expose to the browser, but keep
# all Sentry auth and organization tokens server-side.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Configure an approved provider before enabling outbound notifications.
# EMAIL_FROM=
# RESEND_API_KEY=

# WhatsApp Cloud API. Keep these server-side only. Sending stays disabled until
# WHATSAPP_ALLOW_SEND is set to true after an Owner has tested the connection.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ALLOW_SEND=false

# Gmail API (OAuth 2.0). Keep these server-side only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-mail/callback
EMAIL_FROM=
